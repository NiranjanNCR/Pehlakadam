# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: The connection string to your MongoDB Atlas database instance.
# Replace <username> and <password> with your MongoDB Database Access credentials.
MONGODB_URI=mongodb+srv://Pehlakadama:Pehlakadam@123@cluster0.3oudub1.mongodb.net/Pehlakadam?retryWrites=true&w=majority&appName=Cluster0&compressors=zlib
# =========================================================================================
# 💬 WHATSAPP INTEGRATION CONFIGURATION
# =========================================================================================
# Configure your mobile number here to receive instant career guidance request notifications
# directly on your WhatsApp application.
# Format: Use international format with country code and without leading zeroes or plus symbol (e.g. 919876501234)
# =========================================================================================
ADMIN_WHATSAPP_NUMBER="917428613102"

# =========================================================================================
# 🔒 SECURE ADMIN PORTAL ACCESS VERIFICATION
# =========================================================================================
# The designated email and phone number allowed to access the Pehlakadam Advisor Console (/admin).
# Use international format for phone number without leading '+' or spaces (e.g. 919876501234).
# =========================================================================================
ADMIN_EMAIL="nrjstudywrk@gmail.com"
ADMIN_PHONE="917428613102"

# =========================================================================================
# 💳 RAZORPAY PAYMENT GATEWAY CONFIGURATION
# =========================================================================================
# Provide your Razorpay Key ID and Secret Key to enable 1-click automatic payments and instant enrollment.
# Get these keys from https://dashboard.razorpay.com -> Settings -> API Keys
# =========================================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# =========================================================================================
# Configure SMTP credentials to dispatch HTML assessment summary reports automatically.
# If credentials are not provided or connection fails, the system safely falls back to a 
# simulated transactional dispatch with full console logging.
# =========================================================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@pehlakadam.com"
